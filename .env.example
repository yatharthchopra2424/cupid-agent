# ==============================================================================
# CupidAgent - NVIDIA Nemotron 120B Multi-Key Environment Configuration
# ==============================================================================
# To achieve 40 RPM (Requests Per Minute) without hitting NVIDIA API Catalog rate limits,
# you can provide 4 swappable API keys from 4 free/standard accounts.
# The internal key rotator distributes requests round-robin and automatically
# handles HTTP 429 rate limit backoffs with instant failover to the next active key.

# --- Option A: 4 Distinct Swappable Account Keys (Recommended for 40 RPM) ---
NVIDIA_API_KEY_1=nvapi-your-first-account-key-here
NVIDIA_API_KEY_2=nvapi-your-second-account-key-here
NVIDIA_API_KEY_3=nvapi-your-third-account-key-here
NVIDIA_API_KEY_4=nvapi-your-fourth-account-key-here

# --- Option B: Comma-Separated Key String (Alternative) ---
# NVIDIA_API_KEYS=nvapi-key1,nvapi-key2,nvapi-key3,nvapi-key4

# --- Option C: Single Key Fallback ---
# NVIDIA_API_KEY=nvapi-single-account-key-here

# --- Model & Endpoint Configuration ---
# Target NVIDIA Model (Default: nvidia/nemotron-3.5-super-vl-120b-a12b)
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Note: Even if NO keys are provided, CupidAgent operates cleanly using its
# built-in deterministic dating & compatibility fallback engine with zero crashes.
